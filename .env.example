# Copy this file to .env.local and fill in the values from your Neon project.
# `.env*` is gitignored, so real credentials never reach the repository.

# Pooled connection string used by lib/db.ts.
# Required only by commands and server code that touch the database.
DATABASE_URL=

# Direct (non-pooled) connection used by scripts/db-push.mjs to apply schema
# changes. Optional: the script falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
